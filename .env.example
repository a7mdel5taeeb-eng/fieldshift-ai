# Local application configuration placeholders only. Do not add credentials here.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_API_BASE_URL=http://127.0.0.1:8000/api/v1
ENABLE_DEMO_SNAPSHOTS=false
ENABLE_SMAP=false
# Configure only in a local uncommitted .env. SMAP data require Earthdata Login.
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
# Direct, authorized SPL4SMGP V8 HDF5 granule URL; no credential belongs here.
SMAP_GRANULE_URL=
ENABLE_HLS=false
ENABLE_GPM=false
ENABLE_AI_EXPLANATIONS=false
